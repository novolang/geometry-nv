// geompack.nv — fitting rectangles into a bin: the arithmetic under a
// glyph atlas, a sprite sheet or a texture page.
//
// The algorithm is shelf packing, next fit.  The bin is divided into
// horizontal bands, called shelves, from the top down.  A rectangle
// goes on the last shelf opened when it fits there in width and in
// height.  Otherwise a new shelf opens below the last one, as tall as
// the rectangle, and the rectangle goes there.  Otherwise it does not
// fit, and the bin records a failed placement.  Earlier shelves are
// never revisited.
//
// The state is three integers per shelf, and the number of shelves is
// bounded by the bin's height over the shortest rectangle.  A uniform
// grid of equal cells, the layout of a fixed-width font atlas, is a
// shelf pack whose rectangles are all one size.  Skyline and MaxRects
// packing are tighter, and keep a segment or rectangle list that grows
// with the input.  They are not here.
//
// The caller orders the input.  Sorting by decreasing height is what
// makes shelf packing good, and `place` does not do it.
// `order_by_height` and `order_by_area` answer a permutation, a list of
// indices, rather than a sorted list.  A caller has other data to keep
// with each size, such as a glyph number or a sprite name, and an index
// list keeps all of it in step.
//
// A bin is a value.  `place` answers a new bin and leaves the one it
// was given unchanged, which costs a copy of the placements so far.
// `place_all` packs a whole list with one copy.
//
// These functions allocate, so the module is not part of the build for
// a microcontroller.  They have no effects.

use std.math
use std.bits
use geompoint
use geomrect

// One row of the bin: a horizontal band that rectangles sit on.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.shelf_count(geompack.bin(256, 256))}")
// ```
pub @value
struct GeomShelf
    // The shelf's top edge, measured down from the bin's origin.
    y: Int
    // The shelf's height, fixed by the first rectangle placed on it.  A
    // later rectangle on the shelf is no taller.
    height: Int
    // How much of the shelf's width is spoken for.  The next rectangle
    // on this shelf starts here.
    used: Int

// Where one rectangle ended up, or that it did not fit.
//
// `ok` rather than an optional, which would box the placement (SPEC
// section 14.5).  A bin keeps a placement per input, so the index of a
// placement is the index of its rectangle, and a failed one is a hole
// in the list rather than a shorter list.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.last_placement(geompack.bin(256, 256)).ok}")
// ```
pub @value
struct GeomPlacement
    // Where the rectangle sits in the bin, half-open like every
    // `GeomRectI`.  `geomrect.empty_i()` when `ok` is false.
    rect: GeomRectI
    // Whether it fit at all.
    ok: Bool

// A bin being packed.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.free_area(geompack.bin(256, 256))}")
// ```
pub struct GeomBin
    // How wide the bin is.
    width: Int
    // How tall the bin is.
    height: Int
    // The shelves opened so far, from the top down.  There are at most
    // as many as the bin's height over the shortest rectangle packed.
    shelves: [GeomShelf]
    // Every placement this bin has been asked for, in the order it was
    // asked, the failures included.  An index into this list is an index
    // into the caller's input.
    placed: [GeomPlacement]

// An empty bin of the given size.
//
// A width or height that is not positive gives a bin nothing fits in,
// and `place` on it records a failed placement every time.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.bin(256, 256).width}")
// ```
pub fn bin(width: Int, height: Int) -> GeomBin
    let shelves: [GeomShelf] = []
    let placed: [GeomPlacement] = []
    GeomBin { width: width, height: height, shelves: shelves, placed: placed }

// The bin with one more rectangle packed, or with a failed placement
// recorded.
//
// The rectangle goes on the last shelf opened when it fits there in
// width and in height.  Otherwise a new shelf opens below the last one
// and it goes there.  Otherwise it does not fit, and the bin records a
// failed placement.  A rectangle with a width or height that is not
// positive has nothing to place and is recorded as failed.  The bin
// given is not changed; the answer is a new bin.
//
// ```novo
// use geompack
//
// fn main() [io]
//     let b = geompack.place(geompack.bin(256, 256), 32, 32)
//     println("${geompack.last_placement(b).ok}")
// ```
pub fn place(b: GeomBin, w: Int, h: Int) -> GeomBin
    var shelves = b.shelves[:]
    var placed = b.placed[:]
    let at = spot(shelves, b.width, b.height, w, h)
    record(shelves, placed, at, w, h)
    GeomBin { width: b.width, height: b.height, shelves: shelves, placed: placed }

// The bin with every size packed, in the order given.
//
// The whole-list form of `place`, which copies the bin once rather
// than once per rectangle.  The caller supplies the order: the sizes in
// the order `order_by_height` gives pack best.
//
// ```novo
// use geompack
// use geompoint
//
// fn main() [io]
//     let b = geompack.place_all(geompack.bin(256, 256), [geompoint.sizei(32, 32)])
//     println("${geompack.placed_count(b)}")
// ```
pub fn place_all(b: GeomBin, sizes: [GeomSizeI]) -> GeomBin
    var shelves = b.shelves[:]
    var placed = b.placed[:]
    for sz in sizes
        let at = spot(shelves, b.width, b.height, sz.w, sz.h)
        record(shelves, placed, at, sz.w, sz.h)
    GeomBin { width: b.width, height: b.height, shelves: shelves, placed: placed }

// The indices of `sizes`, tallest first.
//
// The answer is a permutation: `sizes[order[0]]` is the tallest.  Sizes
// of equal height keep their original order, so the answer is the same
// on every run.
//
// ```novo
// use geompack
// use geompoint
// use std.list
//
// fn main() [io]
//     let sz = [geompoint.sizei(8, 8), geompoint.sizei(8, 32)]
//     println("${list.len(geompack.order_by_height(sz))}")
// ```
pub fn order_by_height(sizes: [GeomSizeI]) -> [Int]
    var keys: [Int] = []
    for sz in sizes
        list.push(keys, sz.h)
    order_desc(keys)

// The indices of `sizes`, largest area first.
//
// It packs better than height order when the rectangles are close to
// square, as sprites often are, and worse when their heights differ
// widely, as glyphs do.  Sizes of equal area keep their original order.
//
// ```novo
// use geompack
// use geompoint
// use std.list
//
// fn main() [io]
//     let sz = [geompoint.sizei(8, 8), geompoint.sizei(32, 32)]
//     println("${list.len(geompack.order_by_area(sz))}")
// ```
pub fn order_by_area(sizes: [GeomSizeI]) -> [Int]
    var keys: [Int] = []
    for sz in sizes
        list.push(keys, sz.w * sz.h)
    order_desc(keys)

// Where the most recent `place` put its rectangle.
//
// A placement with `ok` false on a bin nothing has been placed in.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.last_placement(geompack.bin(64, 64)).ok}")
// ```
pub fn last_placement(b: GeomBin) -> GeomPlacement
    let n = list.len(b.placed)
    if n == 0
        return failed()
    b.placed[n - 1]

// Every placement, in the order it was asked for, failures included.
//
// ```novo
// use geompack
// use std.list
//
// fn main() [io]
//     println("${list.len(geompack.placements(geompack.bin(64, 64)))}")
// ```
pub fn placements(b: GeomBin) -> [GeomPlacement]
    b.placed[:]

// The placement at `i`, or one with `ok` false when `i` is out of
// range.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.placement_at(geompack.bin(64, 64), 0).ok}")
// ```
pub fn placement_at(b: GeomBin, i: Int) -> GeomPlacement
    if i < 0 or i >= list.len(b.placed)
        return failed()
    b.placed[i]

// How many placements were asked for, failures included.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.placed_count(geompack.bin(64, 64))}")
// ```
pub fn placed_count(b: GeomBin) -> Int
    list.len(b.placed)

// How many of them fit.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.fitted_count(geompack.bin(64, 64))}")
// ```
pub fn fitted_count(b: GeomBin) -> Int
    var n = 0
    for pl in b.placed
        if pl.ok
            n = n + 1
    n

// How many shelves are open.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.shelf_count(geompack.bin(64, 64))}")
// ```
pub fn shelf_count(b: GeomBin) -> Int
    list.len(b.shelves)

// The area every fitted rectangle covers, together.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.used_area(geompack.bin(64, 64))}")
// ```
pub fn used_area(b: GeomBin) -> Int
    var total = 0
    for pl in b.placed
        if pl.ok
            total = total + geomrect.area_i(pl.rect)
    total

// The bin's area less the used area.
//
// This is not the area still packable.  A shelf packer leaves space at
// the end of every shelf and above the shorter rectangles on it, and
// this number counts that space.  A bin with an extent that is not
// positive has no area and answers 0.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.free_area(geompack.bin(64, 64))}")
// ```
pub fn free_area(b: GeomBin) -> Int
    bin_area(b) - used_area(b)

// The used area as a fraction of the bin's, in `0.0 ..= 1.0`.
//
// The number to compare two orderings by.  A bin with no area answers
// 0.0.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.occupancy(geompack.bin(64, 64))}")
// ```
pub fn occupancy(b: GeomBin) -> Float
    let whole = bin_area(b)
    if whole == 0
        return 0.0
    used_area(b) as Float / whole as Float

// The smallest rectangle containing every fitted placement.
//
// A caller crops the finished sheet to it.  `geomrect.empty_i()` when
// nothing fitted.
//
// ```novo
// use geompack
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty_i(geompack.used_bounds(geompack.bin(64, 64)))}")
// ```
pub fn used_bounds(b: GeomBin) -> GeomRectI
    var box = geomrect.empty_i()
    for pl in b.placed
        if pl.ok
            box = geomrect.union_i(box, pl.rect)
    box

// The smallest power-of-two square that would hold everything placed so
// far.
//
// The side is the smallest power of two at least as large as both the
// width and the height of `used_bounds`, so one number sizes a square
// texture page.  0 when nothing fitted.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.square_page_size(geompack.bin(64, 64))}")
// ```
pub fn square_page_size(b: GeomBin) -> Int
    let box = used_bounds(b)
    if geomrect.is_empty_i(box)
        return 0
    let need = math.max(box.max.x, box.max.y)
    bits.shl(1, bits.bit_len(need - 1))

// Whether a rectangle of this size would fit if placed next.
//
// It asks without changing the bin, for a caller deciding between
// pages.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.would_fit(geompack.bin(64, 64), 32, 32)}")
// ```
pub fn would_fit(b: GeomBin, w: Int, h: Int) -> Bool
    spot(b.shelves, b.width, b.height, w, h).ok

// A packed rectangle as texture coordinates inside the bin: `min` at
// `(0, 0)` and `max` at `(1, 1)` for a rectangle filling the whole bin.
//
// The corners are divided by the bin's size on the half-open rule, so
// the high edge is the first texel outside the rectangle.  A
// coordinate computed from an inclusive high corner would sample one
// texel of the neighbour.  A failed placement, or a bin with no area,
// answers `geomrect.empty()`.
//
// ```novo
// use geompack
// use geomrect
//
// fn main() [io]
//     let b = geompack.place(geompack.bin(64, 64), 32, 32)
//     println("${geomrect.width(geompack.uv_of(b, geompack.last_placement(b)))}")
// ```
pub fn uv_of(b: GeomBin, p: GeomPlacement) -> GeomRectF
    if not p.ok or b.width <= 0 or b.height <= 0
        return geomrect.empty()
    let bw = b.width as Float
    let bh = b.height as Float
    geomrect.of_corners(
        geompoint.ptf(p.rect.min.x as Float / bw, p.rect.min.y as Float / bh),
        geompoint.ptf(p.rect.max.x as Float / bw, p.rect.max.y as Float / bh))

// The bin emptied, keeping its size.
//
// ```novo
// use geompack
//
// fn main() [io]
//     println("${geompack.placed_count(geompack.reset(geompack.bin(64, 64)))}")
// ```
pub fn reset(b: GeomBin) -> GeomBin
    bin(b.width, b.height)

// A placement that did not fit.
fn failed() -> GeomPlacement
    GeomPlacement { rect: geomrect.empty_i(), ok: false }

// The bin's area, or 0 for a bin with an extent that is not positive.
fn bin_area(b: GeomBin) -> Int
    if b.width <= 0 or b.height <= 0
        return 0
    b.width * b.height

// Where the shelf rule would put a `w` by `h` rectangle, without
// changing anything.  The answer's `ok` is false when it fits nowhere.
// A rectangle with an extent that is not positive has nothing to place
// and does not fit.
fn spot(shelves: [GeomShelf], width: Int, height: Int, w: Int, h: Int) -> GeomPlacement
    if w <= 0 or h <= 0 or w > width
        return failed()
    let n = list.len(shelves)
    var top = 0
    if n > 0
        let last = shelves[n - 1]
        if h <= last.height and last.used + w <= width
            return GeomPlacement { rect: geomrect.of_xywh_i(last.used, last.y, w, h), ok: true }
        top = last.y + last.height
    if top + h > height
        return failed()
    GeomPlacement { rect: geomrect.of_xywh_i(0, top, w, h), ok: true }

// Write the placement `at` into the two lists: a new shelf when it sits
// below the last one, or the last shelf's used width moved on when it
// sits beside what is there.
fn record(var shelves: [GeomShelf], var placed: [GeomPlacement], at: GeomPlacement, w: Int, h: Int)
    list.push(placed, at)
    if not at.ok
        return
    let n = list.len(shelves)
    if n > 0 and shelves[n - 1].y == at.rect.min.y
        let last = shelves[n - 1]
        shelves[n - 1] = GeomShelf { y: last.y, height: last.height, used: last.used + w }
    else
        list.push(shelves, GeomShelf { y: at.rect.min.y, height: h, used: w })

// The indices of `keys`, largest key first, with equal keys kept in
// their original order.  Each pair holds a key and its index negated,
// so the ascending sort puts equal keys in descending index order and
// reading the pairs from the end gives the answer.
fn order_desc(keys: [Int]) -> [Int]
    var pairs: [(Int, Int)] = []
    for i in 0..list.len(keys)
        list.push(pairs, (keys[i], 0 - i))
    list.sort(pairs)
    var idx: [Int] = []
    var k = list.len(pairs)
    while k > 0
        k = k - 1
        let (_, neg) = pairs[k]
        list.push(idx, 0 - neg)
    idx
