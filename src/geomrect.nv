pub fn is_empty_i(r: GeomRectI) -> Bool
    todo("geometry-nv.geomrect.is_empty_i")

// Whether the grid point is inside, half-open.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.contains_point_i(r, geompoint.pti(16, 0))}")
// ```
pub fn contains_point_i(r: GeomRectI, p: GeomPointI) -> Bool
    todo("geometry-nv.geomrect.contains_point_i")

// Whether `inner` is entirely within `outer`, on the grid.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let o = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.contains_rect_i(o, geomrect.of_xywh_i(1, 1, 2, 2))}")
// ```
pub fn contains_rect_i(outer: GeomRectI, inner: GeomRectI) -> Bool
    todo("geometry-nv.geomrect.contains_rect_i")

// The region both grid rectangles cover, or an empty one.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.area_i(geomrect.intersection_i(a, geomrect.of_xywh_i(8, 8, 16, 16)))}")
// ```
pub fn intersection_i(a: GeomRectI, b: GeomRectI) -> GeomRectI
    todo("geometry-nv.geomrect.intersection_i")

// The smallest grid rectangle containing both.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh_i(0, 0, 1, 1)
//     println("${geomrect.width_i(geomrect.union_i(a, geomrect.of_xywh_i(9, 0, 1, 1)))}")
