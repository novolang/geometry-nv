pub fn area_i(r: GeomRectI) -> Int
    todo("geometry-nv.geomrect.area_i")

// Whether the grid rectangle encloses nothing.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty_i(geomrect.of_xywh_i(0, 0, 0, 5))}")
