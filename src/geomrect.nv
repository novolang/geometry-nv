pub fn union_i(a: GeomRectI, b: GeomRectI) -> GeomRectI
    todo("geometry-nv.geomrect.union_i")

// The smallest grid rectangle that contains every pixel `r` touches.
//
// Floor on the low corner, ceiling on the high one — so a shape drawn
// into the result is not clipped, which the round-to-nearest rule would
// do at both edges.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.5, 0.5, 1.0, 1.0)
//     println("${geomrect.width_i(geomrect.to_int_outer(r))}")
// ```
pub fn to_int_outer(r: GeomRectF) -> GeomRectI
    todo("geometry-nv.geomrect.to_int_outer")

// The largest grid rectangle entirely inside `r`.
//
// Ceiling on the low corner, floor on the high one.  What a clip
// rectangle wants: no pixel outside `r` is ever written.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.5, 0.5, 1.0, 1.0)
//     println("${geomrect.is_empty_i(geomrect.to_int_inner(r))}")
// ```
pub fn to_int_inner(r: GeomRectF) -> GeomRectI
    todo("geometry-nv.geomrect.to_int_inner")

// A grid rectangle as a continuous one.  Exact.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width(geomrect.to_float_rect(geomrect.of_xywh_i(0, 0, 16, 16)))}")
// ```
pub fn to_float_rect(r: GeomRectI) -> GeomRectF
    todo("geometry-nv.geomrect.to_float_rect")

// A rectangle written as `"(x, y, w, h)"`.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println(geomrect.format(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0)))
// ```
pub fn format(r: GeomRectF) -> Str
    todo("geometry-nv.geomrect.format")
