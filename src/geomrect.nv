// geomrect.nv — axis-aligned rectangles and the algebra over them.
//
// A rectangle is stored as two corners, not as an origin and a size.
// The corner form is the one the algebra wants: a union is a minimum
// and a maximum per axis, an intersection is a maximum and a minimum,
// and containment is four comparisons.  `of_origin_size` and `size_of`
// are the other spelling, for callers whose data arrives that way.
//
// An empty rectangle is a value, not an error.  A low corner that is
// not below the high corner on either axis means the rectangle encloses
// nothing, and `is_empty` says so.  Every function here is defined on
// an empty rectangle: its union with another rectangle is the other
// one, its intersection with anything is empty, and `contains_point`
// is false.  A clip that comes back empty is the ordinary outcome.
//
// `empty()` is the canonical empty rectangle.  Its low corner is at
// positive infinity and its high corner at negative infinity, so it
// holds no point at all, and a bounding box folded with `extend` from
// it starts at the first point.  `normalize` turns any empty rectangle
// into it.  Nothing here normalizes for the caller: most callers only
// ask `is_empty`.
//
// Every function here is `@tier(embedded)`.  The four corners as a
// list are `geompoly.corners`, and the text form is
// `geomtext.format_rect`.

use std.math
use geompoint

// An axis-aligned rectangle, as its low corner and its high corner.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 20.0)
//     println("${geomrect.area(r)}")
// ```
pub @value
struct GeomRectF
    // The corner with the smaller coordinates on both axes, for a
    // rectangle that is not empty.
    min: GeomPointF
    // The corner with the larger coordinates on both axes.  It is
    // exclusive: `contains_point` is a half-open test, so a point on
    // the low edge is inside and a point on the high edge is not.  A
    // grid of abutting rectangles then covers each point once.
    max: GeomPointF

// An axis-aligned rectangle on an integer grid.
//
// The half-open rule is the same.  A `GeomRectI` from `(0, 0)` to
// `(16, 16)` is 16 pixels wide, not 17, and two of them side by side
// share no pixel.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.area_i(r)}")
// ```
pub @value
struct GeomRectI
    // The low corner.
    min: GeomPointI
    // The high corner, exclusive.
    max: GeomPointI

// A rectangle from two corners, as given.
//
// The corners are not sorted.  A caller who hands them the wrong way
// round gets an empty rectangle.  `spanning` sorts them.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_corners(geompoint.ptf(0.0, 0.0), geompoint.ptf(4.0, 3.0))
//     println("${geomrect.width(r)}")
// ```
pub @tier(embedded)
fn of_corners(min: GeomPointF, max: GeomPointF) -> GeomRectF
    GeomRectF { min: min, max: max }

// A rectangle from an origin and a size.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_origin_size(geompoint.ptf(1.0, 1.0), geompoint.sizef(4.0, 3.0))
//     println("${geomrect.height(r)}")
// ```
pub @tier(embedded)
fn of_origin_size(origin: GeomPointF, size: GeomSizeF) -> GeomRectF
    of_xywh(origin.x, origin.y, size.w, size.h)

// A rectangle from four numbers: the low x, the low y, the width and
// the height.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0))}")
// ```
pub @tier(embedded)
fn of_xywh(x: Float, y: Float, w: Float, h: Float) -> GeomRectF
    GeomRectF { min: geompoint.ptf(x, y), max: geompoint.ptf(x + w, y + h) }

// A grid rectangle from two corners, as given.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_corners_i(geompoint.pti(0, 0), geompoint.pti(4, 3))
//     println("${geomrect.width_i(r)}")
// ```
pub @tier(embedded)
fn of_corners_i(min: GeomPointI, max: GeomPointI) -> GeomRectI
    GeomRectI { min: min, max: max }

// A grid rectangle from the low x, the low y, the width and the height.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width_i(geomrect.of_xywh_i(0, 0, 16, 16))}")
// ```
pub @tier(embedded)
fn of_xywh_i(x: Int, y: Int, w: Int, h: Int) -> GeomRectI
    GeomRectI { min: geompoint.pti(x, y), max: geompoint.pti(x + w, y + h) }

// The canonical rectangle that encloses nothing.
//
// Its low corner is at positive infinity and its high corner at
// negative infinity.  It is the identity for `union` and for `extend`,
// and intersecting anything with it gives an empty rectangle.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty(geomrect.empty())}")
// ```
pub @tier(embedded)
fn empty() -> GeomRectF
    let inf = math.infinity()
    GeomRectF { min: geompoint.ptf(inf, inf), max: geompoint.ptf(0.0 - inf, 0.0 - inf) }

// The canonical empty grid rectangle: all four coordinates zero.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty_i(geomrect.empty_i())}")
// ```
pub @tier(embedded)
fn empty_i() -> GeomRectI
    GeomRectI { min: geompoint.pti(0, 0), max: geompoint.pti(0, 0) }

// The smallest rectangle with both points as corners.
//
// The two points may be any two opposite corners, in either order.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.spanning(geompoint.ptf(4.0, 3.0), geompoint.ptf(0.0, 0.0))
//     println("${geomrect.width(r)}")
// ```
pub @tier(embedded)
fn spanning(a: GeomPointF, b: GeomPointF) -> GeomRectF
    GeomRectF {
        min: geompoint.ptf(math.min(a.x, b.x), math.min(a.y, b.y)),
        max: geompoint.ptf(math.max(a.x, b.x), math.max(a.y, b.y)) }

// How wide the rectangle is: `max.x - min.x`, which is zero or negative
// for an empty rectangle.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0))}")
// ```
pub @tier(embedded)
fn width(r: GeomRectF) -> Float
    r.max.x - r.min.x

// How tall the rectangle is: `max.y - min.y`, which is zero or negative
// for an empty rectangle.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.height(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0))}")
// ```
pub @tier(embedded)
fn height(r: GeomRectF) -> Float
    r.max.y - r.min.y

// The rectangle's extents as a size.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.size_of(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0)).h}")
// ```
pub @tier(embedded)
fn size_of(r: GeomRectF) -> GeomSizeF
    geompoint.sizef(width(r), height(r))

// `width * height`, and 0.0 for an empty rectangle.
//
// An area is a measure and is never negative.  A caller who wants the
// signed product has `width` and `height`.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.area(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0))}")
// ```
pub @tier(embedded)
fn area(r: GeomRectF) -> Float
    if is_empty(r)
        return 0.0
    width(r) * height(r)

// The point in the middle.  An empty rectangle answers the origin.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.center(geomrect.of_xywh(0.0, 0.0, 10.0, 20.0)).x}")
// ```
pub @tier(embedded)
fn center(r: GeomRectF) -> GeomPointF
    if is_empty(r)
        return geompoint.origin()
    geompoint.midpoint(r.min, r.max)

// Whether the rectangle encloses nothing: on some axis the low corner
// is not below the high corner.
//
// A rectangle with a coordinate that is not a number is empty too.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty(geomrect.of_xywh(0.0, 0.0, 0.0, 5.0))}")
// ```
pub @tier(embedded)
fn is_empty(r: GeomRectF) -> Bool
    not (r.min.x < r.max.x and r.min.y < r.max.y)

// The same rectangle, or `empty()` when it encloses nothing.
//
// Two empty rectangles from different clips hold different coordinates
// until they are normalized, and the same ones after.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty(geomrect.normalize(geomrect.of_xywh(0.0, 0.0, 0.0 - 1.0, 5.0)))}")
// ```
pub @tier(embedded)
fn normalize(r: GeomRectF) -> GeomRectF
    if is_empty(r)
        return empty()
    r

// Whether the point is inside, on the half-open rule: the low edges
// are in and the high edges are out.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.contains_point(r, geompoint.ptf(10.0, 5.0))}")
// ```
pub @tier(embedded)
fn contains_point(r: GeomRectF, p: GeomPointF) -> Bool
    p.x >= r.min.x and p.x < r.max.x and p.y >= r.min.y and p.y < r.max.y

// Whether `inner` lies entirely within `outer`.
//
// An empty `inner` is contained by every rectangle, an empty one
// included.  That is the answer from set theory, and it keeps
// `contains_rect(a, intersection(a, b))` true for every `a` and `b`.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let o = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.contains_rect(o, geomrect.of_xywh(1.0, 1.0, 2.0, 2.0))}")
// ```
pub @tier(embedded)
fn contains_rect(outer: GeomRectF, inner: GeomRectF) -> Bool
    if is_empty(inner)
        return true
    inner.min.x >= outer.min.x and inner.min.y >= outer.min.y and inner.max.x <= outer.max.x and inner.max.y <= outer.max.y

// Whether the two overlap in a region of positive area.
//
// Rectangles that only touch along an edge do not intersect, which is
// the half-open rule again: a tiled grid reports no overlaps.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh(0.0, 0.0, 5.0, 5.0)
//     println("${geomrect.intersects(a, geomrect.of_xywh(5.0, 0.0, 5.0, 5.0))}")
// ```
pub @tier(embedded)
fn intersects(a: GeomRectF, b: GeomRectF) -> Bool
    not is_empty(intersection(a, b))

// The region both rectangles cover, which may be empty.
//
// The answer is a rectangle rather than an optional.  An intersection
// that comes back empty is the ordinary case, `is_empty` is the
// question, and a rectangle in an optional would be boxed (SPEC section
// 14.5).
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     let b = geomrect.of_xywh(5.0, 5.0, 10.0, 10.0)
//     println("${geomrect.area(geomrect.intersection(a, b))}")
// ```
pub @tier(embedded)
fn intersection(a: GeomRectF, b: GeomRectF) -> GeomRectF
    GeomRectF {
        min: geompoint.ptf(math.max(a.min.x, b.min.x), math.max(a.min.y, b.min.y)),
        max: geompoint.ptf(math.min(a.max.x, b.max.x), math.min(a.max.y, b.max.y)) }

// The smallest rectangle containing both.
//
// An empty operand is ignored: `union(empty(), r)` is `r`.  Taking the
// raw minimum and maximum instead would pull the answer toward
// whatever coordinates the empty operand held.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh(0.0, 0.0, 1.0, 1.0)
//     println("${geomrect.width(geomrect.union(a, geomrect.of_xywh(9.0, 0.0, 1.0, 1.0)))}")
// ```
pub @tier(embedded)
fn union(a: GeomRectF, b: GeomRectF) -> GeomRectF
    if is_empty(a)
        return b
    if is_empty(b)
        return a
    GeomRectF {
        min: geompoint.ptf(math.min(a.min.x, b.min.x), math.min(a.min.y, b.min.y)),
        max: geompoint.ptf(math.max(a.max.x, b.max.x), math.max(a.max.y, b.max.y)) }

// The smallest rectangle with corners around both `r` and `p`.
//
// This is the step a bounding box is folded with, and `empty()` is
// where the fold starts.  A rectangle whose low corner is above its
// high corner on either axis holds no point and is replaced by `p`.  A
// rectangle of zero width or height still holds the points on it, so
// the second step of a fold keeps the first point.  The result's high
// corner is the largest coordinate seen, and a point there is on the
// excluded edge of the half-open rule.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.extend(geomrect.empty(), geompoint.ptf(3.0, 4.0))
//     println("${r.min.x}")
// ```
pub @tier(embedded)
fn extend(r: GeomRectF, p: GeomPointF) -> GeomRectF
    if r.min.x > r.max.x or r.min.y > r.max.y
        return GeomRectF { min: p, max: p }
    GeomRectF {
        min: geompoint.ptf(math.min(r.min.x, p.x), math.min(r.min.y, p.y)),
        max: geompoint.ptf(math.max(r.max.x, p.x), math.max(r.max.y, p.y)) }

// The smallest rectangle with corners around every point in the list.
//
// `empty()` for an empty list.  This is `extend` folded over the list
// from `empty()`.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let ps = [geompoint.ptf(0.0, 0.0), geompoint.ptf(3.0, 4.0)]
//     println("${geomrect.width(geomrect.bounding(ps))}")
// ```
pub @tier(embedded)
fn bounding(points: [GeomPointF]) -> GeomRectF
    var r = empty()
    for p in points
        r = extend(r, p)
    r

// The rectangle moved by `v`.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.translate(geomrect.of_xywh(0.0, 0.0, 1.0, 1.0), geompoint.vecf(5.0, 0.0))
//     println("${r.min.x}")
// ```
pub @tier(embedded)
fn translate(r: GeomRectF, v: GeomVecF) -> GeomRectF
    GeomRectF { min: geompoint.offset(r.min, v), max: geompoint.offset(r.max, v) }

// The rectangle grown by `dx` on each x edge and `dy` on each y edge.
//
// Negative amounts shrink it.  Shrinking past the middle gives
// `empty()` rather than a rectangle turned inside out, and an empty
// rectangle stays `empty()` whatever the amounts.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.inflate(geomrect.of_xywh(1.0, 1.0, 8.0, 8.0), 1.0, 1.0)
//     println("${geomrect.width(r)}")
// ```
pub @tier(embedded)
fn inflate(r: GeomRectF, dx: Float, dy: Float) -> GeomRectF
    inset(r, 0.0 - dx, 0.0 - dy, 0.0 - dx, 0.0 - dy)

// `r` with `left`, `top`, `right` and `bottom` taken off its edges.
//
// `left` is the edge at `min.x` and `top` the edge at `min.y`, which is
// the top on a screen, where y grows down.  A plot's margins are not
// the same on every side: the left one holds tick labels and the top
// one a title.  The same empty rule as `inflate` applies.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.inset(geomrect.of_xywh(0.0, 0.0, 100.0, 100.0), 40.0, 10.0, 10.0, 30.0)
//     println("${geomrect.width(r)}")
// ```
pub @tier(embedded)
fn inset(r: GeomRectF, left: Float, top: Float, right: Float, bottom: Float) -> GeomRectF
    if is_empty(r)
        return empty()
    normalize(GeomRectF {
        min: geompoint.ptf(r.min.x + left, r.min.y + top),
        max: geompoint.ptf(r.max.x - right, r.max.y - bottom) })

// The point of `r` closest to `p`, with the high edges counted in.
//
// `p` itself when it is inside.  An empty rectangle has no points and
// answers the origin.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.clamp_point(r, geompoint.ptf(20.0, 5.0)).x}")
// ```
pub @tier(embedded)
fn clamp_point(r: GeomRectF, p: GeomPointF) -> GeomPointF
    if is_empty(r)
        return geompoint.origin()
    geompoint.ptf(math.min(math.max(p.x, r.min.x), r.max.x), math.min(math.max(p.y, r.min.y), r.max.y))

// Where `p` sits inside `r`, as a fraction per axis: `min` is `(0, 0)`
// and `max` is `(1, 1)`.
//
// The forward half of a scale.  An empty rectangle has no interior to
// place a point in and answers `(0, 0)`.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.relative(r, geompoint.ptf(5.0, 5.0)).x}")
// ```
pub @tier(embedded)
fn relative(r: GeomRectF, p: GeomPointF) -> GeomPointF
    if is_empty(r)
        return geompoint.origin()
    geompoint.ptf((p.x - r.min.x) / width(r), (p.y - r.min.y) / height(r))

// The point at fractional position `f` inside `r`.
//
// The inverse of `relative`, and not clamped.  An empty rectangle
// answers the origin, as `relative` does.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.absolute(r, geompoint.ptf(0.5, 0.5)).x}")
// ```
pub @tier(embedded)
fn absolute(r: GeomRectF, f: GeomPointF) -> GeomPointF
    if is_empty(r)
        return geompoint.origin()
    geompoint.ptf(r.min.x + f.x * width(r), r.min.y + f.y * height(r))

// How wide the grid rectangle is, in whole units.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width_i(geomrect.of_xywh_i(0, 0, 16, 16))}")
// ```
pub @tier(embedded)
fn width_i(r: GeomRectI) -> Int
    r.max.x - r.min.x

// How tall the grid rectangle is, in whole units.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.height_i(geomrect.of_xywh_i(0, 0, 16, 16))}")
// ```
pub @tier(embedded)
fn height_i(r: GeomRectI) -> Int
    r.max.y - r.min.y

// How many whole units the grid rectangle covers; 0 when it is empty.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.area_i(geomrect.of_xywh_i(0, 0, 16, 16))}")
// ```
pub @tier(embedded)
fn area_i(r: GeomRectI) -> Int
    if is_empty_i(r)
        return 0
    width_i(r) * height_i(r)

// Whether the grid rectangle encloses nothing.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.is_empty_i(geomrect.of_xywh_i(0, 0, 0, 5))}")
// ```
pub @tier(embedded)
fn is_empty_i(r: GeomRectI) -> Bool
    r.min.x >= r.max.x or r.min.y >= r.max.y

// Whether the grid point is inside, on the half-open rule.
//
// ```novo
// use geomrect
// use geompoint
//
// fn main() [io]
//     let r = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.contains_point_i(r, geompoint.pti(16, 0))}")
// ```
pub @tier(embedded)
fn contains_point_i(r: GeomRectI, p: GeomPointI) -> Bool
    p.x >= r.min.x and p.x < r.max.x and p.y >= r.min.y and p.y < r.max.y

// Whether `inner` lies entirely within `outer`, on the grid.  An empty
// `inner` is contained by every rectangle.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let o = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.contains_rect_i(o, geomrect.of_xywh_i(1, 1, 2, 2))}")
// ```
pub @tier(embedded)
fn contains_rect_i(outer: GeomRectI, inner: GeomRectI) -> Bool
    if is_empty_i(inner)
        return true
    inner.min.x >= outer.min.x and inner.min.y >= outer.min.y and inner.max.x <= outer.max.x and inner.max.y <= outer.max.y

// The region both grid rectangles cover, which may be empty.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh_i(0, 0, 16, 16)
//     println("${geomrect.area_i(geomrect.intersection_i(a, geomrect.of_xywh_i(8, 8, 16, 16)))}")
// ```
pub @tier(embedded)
fn intersection_i(a: GeomRectI, b: GeomRectI) -> GeomRectI
    GeomRectI {
        min: geompoint.pti(math.max(a.min.x, b.min.x), math.max(a.min.y, b.min.y)),
        max: geompoint.pti(math.min(a.max.x, b.max.x), math.min(a.max.y, b.max.y)) }

// The smallest grid rectangle containing both.  An empty operand is
// ignored.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let a = geomrect.of_xywh_i(0, 0, 1, 1)
//     println("${geomrect.width_i(geomrect.union_i(a, geomrect.of_xywh_i(9, 0, 1, 1)))}")
// ```
pub @tier(embedded)
fn union_i(a: GeomRectI, b: GeomRectI) -> GeomRectI
    if is_empty_i(a)
        return b
    if is_empty_i(b)
        return a
    GeomRectI {
        min: geompoint.pti(math.min(a.min.x, b.min.x), math.min(a.min.y, b.min.y)),
        max: geompoint.pti(math.max(a.max.x, b.max.x), math.max(a.max.y, b.max.y)) }

// The smallest grid rectangle that contains every pixel `r` touches.
//
// The low corner is rounded down and the high corner up, so a shape
// drawn into the result is not clipped at either edge.  An empty `r`
// answers `empty_i()`.  A coordinate outside the range of `Int` stops
// the program, as in `geompoint.to_int_floor`.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.5, 0.5, 1.0, 1.0)
//     println("${geomrect.width_i(geomrect.to_int_outer(r))}")
// ```
pub @tier(embedded)
fn to_int_outer(r: GeomRectF) -> GeomRectI
    if is_empty(r)
        return empty_i()
    GeomRectI { min: geompoint.to_int_floor(r.min), max: ceil_point(r.max) }

// The largest grid rectangle entirely inside `r`.
//
// The low corner is rounded up and the high corner down, so no pixel
// outside `r` is ever written through the result.  It may be empty
// when `r` is narrower than a pixel.  An empty `r` answers `empty_i()`.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.5, 0.5, 1.0, 1.0)
//     println("${geomrect.is_empty_i(geomrect.to_int_inner(r))}")
// ```
pub @tier(embedded)
fn to_int_inner(r: GeomRectF) -> GeomRectI
    if is_empty(r)
        return empty_i()
    GeomRectI { min: ceil_point(r.min), max: geompoint.to_int_floor(r.max) }

// `p` rounded up on both axes: the floor of the negated point, negated.
@tier(embedded)
fn ceil_point(p: GeomPointF) -> GeomPointI
    let down = geompoint.to_int_floor(geompoint.ptf(0.0 - p.x, 0.0 - p.y))
    geompoint.pti(0 - down.x, 0 - down.y)

// A grid rectangle as a continuous one.  Exact.
//
// ```novo
// use geomrect
//
// fn main() [io]
//     println("${geomrect.width(geomrect.to_float_rect(geomrect.of_xywh_i(0, 0, 16, 16)))}")
// ```
pub @tier(embedded)
fn to_float_rect(r: GeomRectI) -> GeomRectF
    GeomRectF { min: geompoint.to_float(r.min), max: geompoint.to_float(r.max) }
