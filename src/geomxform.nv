// geomxform.nv — 2-D affine transforms: translate, scale, shear,
// compose, apply, invert.
//
// An affine transform of the plane is a 3 by 3 matrix whose bottom row
// is always `[0 0 1]`.  `GeomXform` stores the six numbers that vary,
// in the order SVG's `matrix(a b c d e f)` names them.  PostScript's
// six-element array, Cairo's `cairo_matrix_t` and euclid's
// `Transform2D` use the same order, so a transform read from an SVG
// file is six consecutive numbers with no reshuffling.
//
// A point is a row `[x y 1]` multiplied on the left of the matrix:
//
//   x' = a * x + c * y + e
//   y' = b * x + d * y + f
//
// Under that convention `compose(first, second)` applies `first` and
// then `second`, in reading order.  The column-vector convention taught
// in linear algebra would make the same call mean "second, then first".
// There is one spelling of the function, and its parameter names say
// the order.
//
// Every function here is `@tier(embedded)`.  The transforms built from
// an angle are in `geomtrig`, a list of points is transformed by
// `geompoly.apply_points`, and the text form is
// `geomtext.format_matrix`.

use std.math
use geompoint
use geomrect

// An affine transform of the plane.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     let t = geomxform.scaling(2.0, 2.0)
//     println("${t.a}")
// ```
pub @value
struct GeomXform
    // How much of the input x reaches the output x.
    a: Float
    // How much of the input x reaches the output y.
    b: Float
    // How much of the input y reaches the output x.
    c: Float
    // How much of the input y reaches the output y.
    d: Float
    // The translation along x, applied after the linear part.
    e: Float
    // The translation along y, applied after the linear part.
    f: Float

// The transform that changes nothing.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.is_identity(geomxform.identity())}")
// ```
pub @tier(embedded)
fn identity() -> GeomXform
    GeomXform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }

// A transform from the six numbers, in SVG's `matrix(a b c d e f)`
// order.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.of_matrix(1.0, 0.0, 0.0, 1.0, 5.0, 0.0).e}")
// ```
pub @tier(embedded)
fn of_matrix(a: Float, b: Float, c: Float, d: Float, e: Float, f: Float) -> GeomXform
    GeomXform { a: a, b: b, c: c, d: d, e: e, f: f }

// A pure translation.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.translation(5.0, 0.0)
//     println("${geomxform.apply_point(t, geompoint.origin()).x}")
// ```
pub @tier(embedded)
fn translation(tx: Float, ty: Float) -> GeomXform
    GeomXform { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx, f: ty }

// A pure scale about the origin.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.scaling(2.0, 3.0)
//     println("${geomxform.apply_point(t, geompoint.ptf(1.0, 1.0)).y}")
// ```
pub @tier(embedded)
fn scaling(sx: Float, sy: Float) -> GeomXform
    GeomXform { a: sx, b: 0.0, c: 0.0, d: sy, e: 0.0, f: 0.0 }

// A scale about a given point rather than the origin.
//
// The pivot stays where it is.  This is the translation to the origin,
// the scale and the translation back, composed in that order.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.scaling_about(2.0, 2.0, geompoint.ptf(5.0, 5.0))
//     println("${geomxform.apply_point(t, geompoint.ptf(5.0, 5.0)).x}")
// ```
pub @tier(embedded)
fn scaling_about(sx: Float, sy: Float, pivot: GeomPointF) -> GeomXform
    about(scaling(sx, sy), pivot)

// `t` performed about `pivot` rather than the origin: the translation
// that takes `pivot` to the origin, then `t`, then the translation back.
//
// `pivot` stays where it is under any linear `t`.  `scaling_about` and
// `geomtrig.rotation_about` are this function with a scale and a
// rotation.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.about(geomxform.shear(1.0, 0.0), geompoint.ptf(0.0, 2.0))
//     println("${geomxform.apply_point(t, geompoint.ptf(0.0, 3.0)).x}")
// ```
pub @tier(embedded)
fn about(t: GeomXform, pivot: GeomPointF) -> GeomXform
    compose(compose(translation(0.0 - pivot.x, 0.0 - pivot.y), t), translation(pivot.x, pivot.y))

// A shear: x displaced in proportion to y by `shx`, and y in
// proportion to x by `shy`.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.shear(1.0, 0.0).c}")
// ```
pub @tier(embedded)
fn shear(shx: Float, shy: Float) -> GeomXform
    GeomXform { a: 1.0, b: shy, c: shx, d: 1.0, e: 0.0, f: 0.0 }

// The transform that maps `from` onto `to`, axis by axis.
//
// This is the transform a plot is built from: data space in, pixel
// space out.  A `to` whose y runs the other way, with a negative
// height, flips the y axis and produces a negative `d`.  An empty
// `from` has no extent to map and answers the identity.
//
// ```novo
// use geomxform
// use geomrect
//
// fn main() [io]
//     let src = geomrect.of_xywh(0.0, 0.0, 1.0, 1.0)
//     let dst = geomrect.of_xywh(0.0, 100.0, 200.0, 0.0 - 100.0)
//     println("${geomxform.mapping(src, dst).d}")
// ```
pub @tier(embedded)
fn mapping(from: GeomRectF, to: GeomRectF) -> GeomXform
    if geomrect.is_empty(from)
        return identity()
    let sx = geomrect.width(to) / geomrect.width(from)
    let sy = geomrect.height(to) / geomrect.height(from)
    GeomXform { a: sx,
        b: 0.0,
        c: 0.0,
        d: sy,
        e: to.min.x - from.min.x * sx,
        f: to.min.y - from.min.y * sy }

// The transform that applies `first` and then `second`.
//
// The argument written first happens first.  In matrix terms this is
// `first * second` under the row-vector convention of the module
// header.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.compose(geomxform.scaling(2.0, 2.0), geomxform.translation(1.0, 0.0))
//     println("${geomxform.apply_point(t, geompoint.ptf(1.0, 0.0)).x}")
// ```
pub @tier(embedded)
fn compose(first: GeomXform, second: GeomXform) -> GeomXform
    GeomXform {
        a: first.a * second.a + first.b * second.c,
        b: first.a * second.b + first.b * second.d,
        c: first.c * second.a + first.d * second.c,
        d: first.c * second.b + first.d * second.d,
        e: first.e * second.a + first.f * second.c + second.e,
        f: first.e * second.b + first.f * second.d + second.f }

// `t` followed by a translation.
//
// The accumulating form, for a caller walking a tree of nested groups.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.translated(geomxform.identity(), 5.0, 0.0).e}")
// ```
pub @tier(embedded)
fn translated(t: GeomXform, tx: Float, ty: Float) -> GeomXform
    compose(t, translation(tx, ty))

// `t` followed by a scale about the origin.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.scaled(geomxform.identity(), 2.0, 2.0).a}")
// ```
pub @tier(embedded)
fn scaled(t: GeomXform, sx: Float, sy: Float) -> GeomXform
    compose(t, scaling(sx, sy))

// Where `t` sends the point `p`.  The translation applies.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.translation(5.0, 0.0)
//     println("${geomxform.apply_point(t, geompoint.ptf(1.0, 0.0)).x}")
// ```
pub @tier(embedded)
fn apply_point(t: GeomXform, p: GeomPointF) -> GeomPointF
    geompoint.ptf(t.a * p.x + t.c * p.y + t.e, t.b * p.x + t.d * p.y + t.f)

// Where `t` sends the displacement `v`.  The translation does not
// apply.
//
// A displacement is the difference of two positions, and moving both
// positions by the same amount leaves the difference unchanged.  A
// direction, a normal or an edge passed through `apply_point` instead
// picks up the translation, and the error shows only once the
// transform is more than a rotation.
//
// ```novo
// use geomxform
// use geompoint
//
// fn main() [io]
//     let t = geomxform.translation(5.0, 0.0)
//     println("${geomxform.apply_vec(t, geompoint.vecf(1.0, 0.0)).dx}")
// ```
pub @tier(embedded)
fn apply_vec(t: GeomXform, v: GeomVecF) -> GeomVecF
    geompoint.vecf(t.a * v.dx + t.c * v.dy, t.b * v.dx + t.d * v.dy)

// The smallest axis-aligned rectangle around the transformed
// rectangle.
//
// A rotated rectangle is not axis-aligned, so this is the bounding box
// of the four transformed corners.  It is larger than the original
// under any rotation that is not a multiple of a quarter turn, and
// applying it twice loses area both times.  A caller that needs the
// quadrilateral itself transforms `geompoly.corners` instead.  An
// empty rectangle answers `geomrect.empty()`.
//
// ```novo
// use geomxform
// use geomrect
//
// fn main() [io]
//     let r = geomrect.of_xywh(0.0, 0.0, 10.0, 10.0)
//     println("${geomrect.width(geomxform.apply_rect(geomxform.scaling(2.0, 2.0), r))}")
// ```
pub @tier(embedded)
fn apply_rect(t: GeomXform, r: GeomRectF) -> GeomRectF
    if geomrect.is_empty(r)
        return geomrect.empty()
    let p0 = apply_point(t, r.min)
    let p1 = apply_point(t, geompoint.ptf(r.max.x, r.min.y))
    let p2 = apply_point(t, r.max)
    let p3 = apply_point(t, geompoint.ptf(r.min.x, r.max.y))
    let lo = geompoint.ptf(math.min(math.min(p0.x, p1.x), math.min(p2.x, p3.x)),
                           math.min(math.min(p0.y, p1.y), math.min(p2.y, p3.y)))
    let hi = geompoint.ptf(math.max(math.max(p0.x, p1.x), math.max(p2.x, p3.x)),
                           math.max(math.max(p0.y, p1.y), math.max(p2.y, p3.y)))
    geomrect.of_corners(lo, hi)

// `a * d - b * c`: the factor the transform multiplies area by.
//
// Zero means the transform flattens the plane onto a line or a point
// and has no inverse.  A negative value means it mirrors.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.determinant(geomxform.scaling(2.0, 3.0))}")
// ```
pub @tier(embedded)
fn determinant(t: GeomXform) -> Float
    t.a * t.d - t.b * t.c

// Whether the transform can be undone without losing the answer to
// rounding.
//
// The test is relative to the transform's own scale: the determinant
// must exceed `1e-12` times the square of the largest of `a`, `b`, `c`
// and `d` in magnitude.  A transform that scales everything by `1e-7`
// is still invertible.  A transform with a coordinate that is not a
// number is not.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.is_invertible(geomxform.scaling(0.0, 1.0))}")
// ```
pub @tier(embedded)
fn is_invertible(t: GeomXform) -> Bool
    let m = math.max(math.max(magnitude(t.a), magnitude(t.b)), math.max(magnitude(t.c), magnitude(t.d)))
    magnitude(determinant(t)) > m * m * 0.000000000001

// `x` without its sign, written with a comparison so the device build
// needs no absolute-value call.
@tier(embedded)
fn magnitude(x: Float) -> Float
    if x < 0.0
        return 0.0 - x
    x

// The transform that undoes `t`, or the identity when `is_invertible`
// is false.
//
// The identity is a safe wrong answer: a caller who skipped the
// question sees untransformed coordinates, rather than a matrix that
// turns every later point into a value that is not a number.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.invert(geomxform.scaling(2.0, 2.0)).a}")
// ```
pub @tier(embedded)
fn invert(t: GeomXform) -> GeomXform
    if not is_invertible(t)
        return identity()
    let det = determinant(t)
    GeomXform {
        a: t.d / det,
        b: (0.0 - t.b) / det,
        c: (0.0 - t.c) / det,
        d: t.a / det,
        e: (t.c * t.f - t.d * t.e) / det,
        f: (t.b * t.e - t.a * t.f) / det }

// Whether `t` is exactly the identity.  `near(t, identity(), eps)` is
// the question with a tolerance.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.is_identity(geomxform.identity())}")
// ```
pub @tier(embedded)
fn is_identity(t: GeomXform) -> Bool
    is_translation(t) and t.e == 0.0 and t.f == 0.0

// Whether `t` is a translation and nothing else: its linear part is
// exactly the identity.
//
// A renderer can then add two numbers per point instead of doing four
// multiplications, and a whole-number translation needs no resampling.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.is_translation(geomxform.translation(5.0, 0.0))}")
// ```
pub @tier(embedded)
fn is_translation(t: GeomXform) -> Bool
    t.a == 1.0 and t.d == 1.0 and is_axis_aligned(t)

// Whether `t` maps axis-aligned rectangles to axis-aligned rectangles:
// `b` and `c` are exactly zero, so it is a scale and a translation with
// no rotation or shear.  `apply_rect` is exact for such a transform.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.is_axis_aligned(geomxform.scaling(2.0, 3.0))}")
// ```
pub @tier(embedded)
fn is_axis_aligned(t: GeomXform) -> Bool
    t.b == 0.0 and t.c == 0.0

// Whether two transforms agree to within `eps` on every entry.
//
// ```novo
// use geomxform
//
// fn main() [io]
//     println("${geomxform.near(geomxform.identity(), geomxform.identity(), 0.0001)}")
// ```
pub @tier(embedded)
fn near(a: GeomXform, b: GeomXform, eps: Float) -> Bool
    let linear = magnitude(a.a - b.a) <= eps and magnitude(a.b - b.b) <= eps and magnitude(a.c - b.c) <= eps and magnitude(a.d - b.d) <= eps
    linear and magnitude(a.e - b.e) <= eps and magnitude(a.f - b.f) <= eps
