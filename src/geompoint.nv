// geompoint.nv — points, vectors and sizes, in a Float flavour and an
// Int flavour, as unboxed values.
//
// There are two flavours rather than one generic `GeomPoint<T>`,
// because a generic function whose return type applies a generic head
// is not emitted for a call from another module on this toolchain, and
// a library is nothing but those calls.  The division also matches a
// real difference.  A Float point is a position in a continuous space
// and an Int point is a pixel.  `to_int_floor` and `to_int_round` are
// the places where a position becomes a pixel.
//
// Every type here is `@value` (SPEC section 14).  It is laid out with
// true field widths and passed in registers, and a `[GeomPointF]` is
// one flat buffer with no per-element cell and no per-element reference
// count (SPEC section 14.6).  A `@value` struct may also sit in an
// optional, a `Result` or a boxed struct's field, but each of those
// positions boxes a copy and so allocates (SPEC section 14.5).  No
// function in this module or in `geomrect` and `geomxform` answers one
// of those shapes.  Where an answer can be absent, the value carries
// it: an empty rectangle, a placement whose `ok` is false.
//
// Every function here is `@tier(embedded)`: plain arithmetic on the
// arguments, with no allocation and no call into the C maths library.
// The functions that need a square root or a trigonometric function
// are in `geomtrig`, and the text renderings are in `geomtext`.

// A position in continuous 2-D space.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let p = geompoint.ptf(3.0, 4.0)
//     println("${p.x}")
// ```
pub @value
struct GeomPointF
    // Distance along x, increasing right.
    x: Float
    // Distance along y.  The direction is the caller's choice: nothing
    // here assumes that y grows down, as on a screen, or up, as on a
    // plot.  A `GeomXform` between the two is what reconciles them.
    y: Float

// A position on an integer grid: a pixel, a cell, a texel.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let p = geompoint.pti(3, 4)
//     println("${p.x}")
// ```
pub @value
struct GeomPointI
    // Column, increasing right.
    x: Int
    // Row, in the direction the caller chooses, as for `GeomPointF.y`.
    y: Int

// A displacement in continuous 2-D space.
//
// A vector is a separate type from a point.  A point minus a point is a
// vector, and a point plus a point means nothing.  An affine transform
// also treats the two differently: `geomxform.apply_point` applies the
// translation and `geomxform.apply_vec` does not.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let v = geompoint.vecf(3.0, 4.0)
//     println("${geompoint.length_sq(v)}")
// ```
pub @value
struct GeomVecF
    // Displacement along x.
    dx: Float
    // Displacement along y.
    dy: Float

// A displacement on an integer grid.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let v = geompoint.veci(3, 4)
//     println("${v.dx}")
// ```
pub @value
struct GeomVecI
    // Displacement along x.
    dx: Int
    // Displacement along y.
    dy: Int

// An extent: how wide and how tall, with no position.
//
// A negative extent is allowed and means an empty size.
// `size_is_empty` is the question, and `geomrect` treats a rectangle
// built from an empty size as empty.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let s = geompoint.sizef(640.0, 480.0)
//     println("${geompoint.area_of(s)}")
// ```
pub @value
struct GeomSizeF
    // Extent along x.  May be negative, which means empty.
    w: Float
    // Extent along y.  May be negative, which means empty.
    h: Float

// An extent in whole units: a bitmap, a texture, a bin.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let s = geompoint.sizei(16, 16)
//     println("${geompoint.area_of_i(s)}")
// ```
pub @value
struct GeomSizeI
    // Extent along x.  May be negative, which means empty.
    w: Int
    // Extent along y.  May be negative, which means empty.
    h: Int

// A point from its coordinates.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.ptf(1.5, 2.5).y}")
// ```
pub @tier(embedded)
fn ptf(x: Float, y: Float) -> GeomPointF
    GeomPointF { x: x, y: y }

// A grid point from its coordinates.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.pti(1, 2).y}")
// ```
pub @tier(embedded)
fn pti(x: Int, y: Int) -> GeomPointI
    GeomPointI { x: x, y: y }

// A vector from its components.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.vecf(1.0, 0.0).dx}")
// ```
pub @tier(embedded)
fn vecf(dx: Float, dy: Float) -> GeomVecF
    GeomVecF { dx: dx, dy: dy }

// A grid vector from its components.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.veci(1, 0).dx}")
// ```
pub @tier(embedded)
fn veci(dx: Int, dy: Int) -> GeomVecI
    GeomVecI { dx: dx, dy: dy }

// A size from its extents.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.sizef(2.0, 3.0).w}")
// ```
pub @tier(embedded)
fn sizef(w: Float, h: Float) -> GeomSizeF
    GeomSizeF { w: w, h: h }

// A whole-unit size from its extents.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.sizei(2, 3).w}")
// ```
pub @tier(embedded)
fn sizei(w: Int, h: Int) -> GeomSizeI
    GeomSizeI { w: w, h: h }

// The point at `(0, 0)`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.origin().x}")
// ```
pub @tier(embedded)
fn origin() -> GeomPointF
    GeomPointF { x: 0.0, y: 0.0 }

// The vector `(0, 0)`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.zero_vec().dx}")
// ```
pub @tier(embedded)
fn zero_vec() -> GeomVecF
    GeomVecF { dx: 0.0, dy: 0.0 }

// The point `p` displaced by `v`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let p = geompoint.offset(geompoint.ptf(1.0, 1.0), geompoint.vecf(2.0, 3.0))
//     println("${p.x}")
// ```
pub @tier(embedded)
fn offset(p: GeomPointF, v: GeomVecF) -> GeomPointF
    GeomPointF { x: p.x + v.dx, y: p.y + v.dy }

// The displacement that takes `from` to `to`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let v = geompoint.between(geompoint.ptf(1.0, 1.0), geompoint.ptf(4.0, 5.0))
//     println("${v.dy}")
// ```
pub @tier(embedded)
fn between(from: GeomPointF, to: GeomPointF) -> GeomVecF
    GeomVecF { dx: to.x - from.x, dy: to.y - from.y }

// Two vectors added.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.add(geompoint.vecf(1.0, 2.0), geompoint.vecf(3.0, 4.0)).dx}")
// ```
pub @tier(embedded)
fn add(a: GeomVecF, b: GeomVecF) -> GeomVecF
    GeomVecF { dx: a.dx + b.dx, dy: a.dy + b.dy }

// `a` minus `b`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.sub(geompoint.vecf(3.0, 4.0), geompoint.vecf(1.0, 2.0)).dx}")
// ```
pub @tier(embedded)
fn sub(a: GeomVecF, b: GeomVecF) -> GeomVecF
    GeomVecF { dx: a.dx - b.dx, dy: a.dy - b.dy }

// `v` scaled by `k`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.scale(geompoint.vecf(1.0, 2.0), 3.0).dy}")
// ```
pub @tier(embedded)
fn scale(v: GeomVecF, k: Float) -> GeomVecF
    GeomVecF { dx: v.dx * k, dy: v.dy * k }

// `v` turned the other way.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.negate(geompoint.vecf(1.0, 2.0)).dx}")
// ```
pub @tier(embedded)
fn negate(v: GeomVecF) -> GeomVecF
    GeomVecF { dx: 0.0 - v.dx, dy: 0.0 - v.dy }

// The dot product: `a.dx * b.dx + a.dy * b.dy`.
//
// It is zero exactly when the two vectors are perpendicular.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.dot(geompoint.vecf(1.0, 0.0), geompoint.vecf(0.0, 1.0))}")
// ```
pub @tier(embedded)
fn dot(a: GeomVecF, b: GeomVecF) -> Float
    a.dx * b.dx + a.dy * b.dy

// The 2-D cross product: `a.dx * b.dy - a.dy * b.dx`.
//
// It is a scalar, because in two dimensions the product points out of
// the plane.  Its sign says whether `b` turns toward positive y from
// `a` (positive) or away from it (negative).  `geompoly.winding` and
// `geompoly.is_convex` read that sign.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.cross(geompoint.vecf(1.0, 0.0), geompoint.vecf(0.0, 1.0))}")
// ```
pub @tier(embedded)
fn cross(a: GeomVecF, b: GeomVecF) -> Float
    a.dx * b.dy - a.dy * b.dx

// How long `v` is, squared.  No square root is taken.
//
// This is the form to compare with.  Sorting by distance, testing a
// radius and finding a nearest point never need the root.
// `geomtrig.length` takes it.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.length_sq(geompoint.vecf(3.0, 4.0))}")
// ```
pub @tier(embedded)
fn length_sq(v: GeomVecF) -> Float
    v.dx * v.dx + v.dy * v.dy

// `v` turned a quarter turn, from positive x toward positive y.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.perpendicular(geompoint.vecf(1.0, 0.0)).dy}")
// ```
pub @tier(embedded)
fn perpendicular(v: GeomVecF) -> GeomVecF
    GeomVecF { dx: 0.0 - v.dy, dy: v.dx }

// How far apart two points are, squared.  The comparison form.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.distance_sq(geompoint.ptf(0.0, 0.0), geompoint.ptf(3.0, 4.0))}")
// ```
pub @tier(embedded)
fn distance_sq(a: GeomPointF, b: GeomPointF) -> Float
    length_sq(between(a, b))

// The point `t` of the way from `a` to `b`.
//
// `t` is not clamped.  0.0 is `a`, 1.0 is `b`, and 2.0 is as far past
// `b` again.  An axis tick outside the data range and a ray beyond its
// segment both use values outside `0.0 ..= 1.0`.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.lerp(geompoint.ptf(0.0, 0.0), geompoint.ptf(10.0, 0.0), 0.5).x}")
// ```
pub @tier(embedded)
fn lerp(a: GeomPointF, b: GeomPointF, t: Float) -> GeomPointF
    GeomPointF { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }

// The point halfway between two points.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.midpoint(geompoint.ptf(0.0, 0.0), geompoint.ptf(4.0, 0.0)).x}")
// ```
pub @tier(embedded)
fn midpoint(a: GeomPointF, b: GeomPointF) -> GeomPointF
    GeomPointF { x: (a.x + b.x) * 0.5, y: (a.y + b.y) * 0.5 }

// Whether two points differ by at most `eps` on each axis.
//
// The comparison operators reject a `@value` struct (SPEC section
// 14.5), and exact equality of two Floats is rarely the right test.
// This one takes the tolerance as an argument.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.near(geompoint.ptf(1.0, 1.0), geompoint.ptf(1.0, 1.0), 0.0001)}")
// ```
pub @tier(embedded)
fn near(a: GeomPointF, b: GeomPointF, eps: Float) -> Bool
    within(a.x - b.x, eps) and within(a.y - b.y, eps)

// Whether `d` lies in `[-eps, eps]`.  Written with two comparisons, so
// the device build needs no absolute-value call.
@tier(embedded)
fn within(d: Float, eps: Float) -> Bool
    d <= eps and 0.0 - d <= eps

// A grid point as a continuous one.  Exact for every coordinate below
// 2 to the 53rd.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_float(geompoint.pti(3, 4)).x}")
// ```
pub @tier(embedded)
fn to_float(p: GeomPointI) -> GeomPointF
    GeomPointF { x: p.x as Float, y: p.y as Float }

// A continuous point on the grid, rounded down on both axes.
//
// This is the pixel the position falls inside.  Rounding down stays
// monotonic across zero, which truncation toward zero does not: -0.5
// falls in pixel -1.  A coordinate that is not a number, or is outside
// the range of `Int`, stops the program (SPEC section 13.3).
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_int_floor(geompoint.ptf(0.0 - 0.5, 3.9)).x}")
// ```
pub @tier(embedded)
fn to_int_floor(p: GeomPointF) -> GeomPointI
    GeomPointI { x: floor_int(p.x), y: floor_int(p.y) }

// A continuous point on the grid, rounded to the nearest whole number,
// with halves rounded away from zero.
//
// This is the rule for placing a mark on the nearest pixel.  The same
// range rule as `to_int_floor` applies.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_int_round(geompoint.ptf(3.5, 3.4)).x}")
// ```
pub @tier(embedded)
fn to_int_round(p: GeomPointF) -> GeomPointI
    GeomPointI { x: round_int(p.x), y: round_int(p.y) }

// `x` rounded down to a whole number.  The cast truncates toward zero,
// and a negative value with a fraction is then one too high.
@tier(embedded)
fn floor_int(x: Float) -> Int
    let t = x as Int
    if (t as Float) > x
        return t - 1
    t

// `x` rounded to the nearest whole number, halves away from zero.  The
// fraction `x - t` is exact, because `t` is `x` with its fraction
// removed, so no half is misread by an addition that rounds.
@tier(embedded)
fn round_int(x: Float) -> Int
    let t = x as Int
    let frac = x - t as Float
    if frac >= 0.5
        return t + 1
    if frac <= 0.0 - 0.5
        return t - 1
    t

// A grid vector as a continuous one.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.vec_to_float(geompoint.veci(3, 4)).dx}")
// ```
pub @tier(embedded)
fn vec_to_float(v: GeomVecI) -> GeomVecF
    GeomVecF { dx: v.dx as Float, dy: v.dy as Float }

// A grid size as a continuous one.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.size_to_float(geompoint.sizei(16, 16)).w}")
// ```
pub @tier(embedded)
fn size_to_float(s: GeomSizeI) -> GeomSizeF
    GeomSizeF { w: s.w as Float, h: s.h as Float }

// `w * h`, which is negative or zero for an empty size.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.area_of(geompoint.sizef(3.0, 4.0))}")
// ```
pub @tier(embedded)
fn area_of(s: GeomSizeF) -> Float
    s.w * s.h

// `w * h` in whole units.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.area_of_i(geompoint.sizei(3, 4))}")
// ```
pub @tier(embedded)
fn area_of_i(s: GeomSizeI) -> Int
    s.w * s.h

// Whether a size encloses nothing: either extent is zero or negative.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.size_is_empty(geompoint.sizef(0.0, 5.0))}")
// ```
pub @tier(embedded)
fn size_is_empty(s: GeomSizeF) -> Bool
    not (s.w > 0.0 and s.h > 0.0)

// Whether a whole-unit size encloses nothing.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.size_is_empty_i(geompoint.sizei(0, 5))}")
// ```
pub @tier(embedded)
fn size_is_empty_i(s: GeomSizeI) -> Bool
    s.w <= 0 or s.h <= 0
