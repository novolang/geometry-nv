// The point `t` of the way from `a` to `b`.
//
// `t` is NOT clamped: 0.0 is `a`, 1.0 is `b`, and 2.0 is as far past
// `b` again.  Extrapolation is the useful half — an axis tick outside
// the data range and a ray beyond its segment both want it — and a
// caller who wants the clamp says so.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.lerp(geompoint.ptf(0.0, 0.0), geompoint.ptf(10.0, 0.0), 0.5).x}")
// ```
pub fn lerp(a: GeomPointF, b: GeomPointF, t: Float) -> GeomPointF
    todo("geometry-nv.geompoint.lerp")

// The point halfway between two points.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.midpoint(geompoint.ptf(0.0, 0.0), geompoint.ptf(4.0, 0.0)).x}")
// ```
pub fn midpoint(a: GeomPointF, b: GeomPointF) -> GeomPointF
    todo("geometry-nv.geompoint.midpoint")

// Whether two points are the same to within `eps`.
//
// The comparison operators reject a `@value` struct (SPEC §14.5), and
// comparing two Floats for exact equality is the wrong question anyway.
// This is the right one, and it puts the tolerance where it belongs.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.near(geompoint.ptf(1.0, 1.0), geompoint.ptf(1.0, 1.0), 0.0001)}")
// ```
pub fn near(a: GeomPointF, b: GeomPointF, eps: Float) -> Bool
    todo("geometry-nv.geompoint.near")

// A grid point as a continuous one.  Exact.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_float(geompoint.pti(3, 4)).x}")
// ```
pub fn to_float(p: GeomPointI) -> GeomPointF
    todo("geometry-nv.geompoint.to_float")

// A continuous point on the grid, rounded DOWN in both axes.
//
// The pixel a position falls INSIDE — the rule a rasteriser wants, and
// the one that stays monotonic across zero, which truncation toward
// zero does not.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_int_floor(geompoint.ptf(0.0 - 0.5, 3.9)).x}")
// ```
pub fn to_int_floor(p: GeomPointF) -> GeomPointI
    todo("geometry-nv.geompoint.to_int_floor")

// A continuous point on the grid, rounded to NEAREST, halves away from
// zero.
//
// The rule for placing a mark: the nearest pixel, not the one below.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.to_int_round(geompoint.ptf(3.5, 3.4)).x}")
// ```
pub fn to_int_round(p: GeomPointF) -> GeomPointI
    todo("geometry-nv.geompoint.to_int_round")

