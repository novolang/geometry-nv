// The dot product: `a.dx * b.dx + a.dy * b.dy`.
//
// Zero exactly when the two are perpendicular, which is how a
// containment test asks which side of an edge a point is on.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.dot(geompoint.vecf(1.0, 0.0), geompoint.vecf(0.0, 1.0))}")
// ```
pub fn dot(a: GeomVecF, b: GeomVecF) -> Float
    todo("geometry-nv.geompoint.dot")

// The 2-D cross product: `a.dx * b.dy - a.dy * b.dx`.
//
// A scalar rather than a vector, because in two dimensions the result
// only ever points out of the plane.  Its SIGN is the useful part: it
// says whether `b` turns left or right of `a`, which is what
// `geompoly.winding` and the convexity test are counting.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.cross(geompoint.vecf(1.0, 0.0), geompoint.vecf(0.0, 1.0))}")
// ```
pub fn cross(a: GeomVecF, b: GeomVecF) -> Float
    todo("geometry-nv.geompoint.cross")

// How long `v` is.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.length(geompoint.vecf(3.0, 4.0))}")
// ```
pub fn length(v: GeomVecF) -> Float
    todo("geometry-nv.geompoint.length")

// How long `v` is, SQUARED — no square root taken.
//
// The one to compare with: sorting by distance, testing a radius or
// finding a nearest point never needs the root, and on a device the
// root is the expensive call in the loop.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.length_sq(geompoint.vecf(3.0, 4.0))}")
// ```
pub fn length_sq(v: GeomVecF) -> Float
    todo("geometry-nv.geompoint.length_sq")

// `v` scaled to length 1.
//
// The zero vector has no direction, and normalising it returns THE ZERO
// VECTOR rather than a NaN one — a value the caller can keep computing
// with, whose `length` is 0.0, so the mistake stays visible instead of
// poisoning everything downstream.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.normalize(geompoint.vecf(3.0, 4.0)).dx}")
// ```
pub fn normalize(v: GeomVecF) -> GeomVecF
    todo("geometry-nv.geompoint.normalize")

// `v` turned a quarter turn, toward positive y.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     println("${geompoint.perpendicular(geompoint.vecf(1.0, 0.0)).dy}")
// ```
pub fn perpendicular(v: GeomVecF) -> GeomVecF
    todo("geometry-nv.geompoint.perpendicular")

// The angle `v` points in, in radians, measured from positive x.
