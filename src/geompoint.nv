// geompoint.nv — points, vectors and sizes, in a Float flavour and an
// Int flavour, as UNBOXED values.
//
// WHY TWO FLAVOURS AND NOT ONE GENERIC.  `GeomPoint<T>` would be one
// declaration and no code: a generic function whose return type applies
// a generic head is not emitted for a call from another module on this
// toolchain, and a library is nothing but cross-module calls.  So the
// two flavours are written out.  The division earns its keep anyway —
// a Float point is a position in a continuous space and an Int point is
// a pixel, and the conversions between them (`to_int_floor`,
// `to_int_round`) are the places where that difference is decided ON
// PURPOSE rather than by whichever cast the caller reached for.
//
// WHY `@value`.  These are the types a drawing loop makes a hundred
// thousand of.  `@value` lays them out with true field widths, passes
// them in registers, and stores a `[GeomPointF]` as ONE flat buffer
// with no per-element cell and no per-element reference count
// (SPEC §14.6).  That is what makes the device claim in
// `tests/embedded_probe.nv` possible.
//
// WHAT `@value` COSTS, because it shapes every signature in this
// package (SPEC §14.5).  An unboxed struct may be a local, a parameter,
// a return, a field of another `@value` struct, and an element of a
// list — and nothing else.  It may not be an optional payload, a
// `Result` payload, a tuple element, an enum payload, or a field of a
// boxed struct.  So:
//
//   - no function here returns `?GeomPointF` or
//     `Result<GeomRectF, GeomFault>`.  Where an answer can be absent,
//     the VALUE carries the answer — an empty rectangle, a placement
//     with `ok` false — and a companion predicate asks.
//   - `GeomPoly` and `GeomBin` are BOXED, and they hold their unboxed
//     parts in lists (`[GeomPointF]`, `[GeomShelf]`), which is a
//     supported position.  They could not hold one as a plain field.
//   - a consumer that wants one of these inside an enum payload — a
//     drawing op, an SVG node — carries the numbers instead and
//     rebuilds the struct.  svg-nv's `SvgTransform` is that bridge
//     written once.
//
// NO EFFECTS, and there is nothing to declare: every function is an
// expression over its arguments.

// A position in continuous 2-D space.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let p = geompoint.ptf(3.0, 4.0)
//     println("${p.x}")
// ```
pub @value
struct GeomPointF
    // Distance along x, increasing right.
    x: Float
    // Distance along y.  THE DIRECTION IS THE CALLER'S: this package
    // never assumes y grows down (a screen) or up (a plot), and every
    // function here works either way.  The two consumers disagree —
    // svg-nv's y grows down, plot-nv's data space grows up — and a
    // `GeomXform` between them is what reconciles them.
    y: Float

// A position on an integer grid: a pixel, a cell, a texel.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let p = geompoint.pti(3, 4)
//     println("${p.x}")
// ```
pub @value
struct GeomPointI
    // Column, increasing right.
    x: Int
    // Row.  Same caller's-choice rule as `GeomPointF.y`.
    y: Int

// A displacement in continuous 2-D space.
//
// A SEPARATE TYPE FROM `GeomPointF` on purpose, and it is the one place
// this package is stricter than the arithmetic requires.  A point plus
// a point is meaningless and a point minus a point is a vector; making
// them one type makes both spellable.  And a rotation applied to a
// position is not the same operation as a rotation applied to a
// displacement — `geomxform.apply_point` translates, `apply_vec` does
// not — which is a bug the type separation catches at the call.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let v = geompoint.vecf(3.0, 4.0)
//     println("${geompoint.length(v)}")
// ```
pub @value
struct GeomVecF
    // Displacement along x.
    dx: Float
    // Displacement along y.
    dy: Float

// A displacement on an integer grid.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let v = geompoint.veci(3, 4)
//     println("${v.dx}")
// ```
pub @value
struct GeomVecI
    // Displacement along x.
    dx: Int
    // Displacement along y.
    dy: Int

// An extent: how wide and how tall, with no position.
//
// Negative extents are REPRESENTABLE and mean an empty size;
// `size_is_empty` is the question, and `geomrect` treats a rectangle
// built from one as empty.  Refusing them at construction would cost
// every caller a `Result` for a case the algebra already answers — a
// clipped rectangle is routinely empty, and that is not an error.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let s = geompoint.sizef(640.0, 480.0)
//     println("${geompoint.area_of(s)}")
// ```
pub @value
struct GeomSizeF
    // Extent along x.  May be negative, which means empty.
    w: Float
    // Extent along y.  May be negative, which means empty.
    h: Float

// An extent in whole units: a bitmap, a texture, a bin.
//
// ```novo
// use geompoint
//
// fn main() [io]
//     let s = geompoint.sizei(16, 16)
//     println("${geompoint.area_of_i(s)}")
// ```
pub @value
struct GeomSizeI
    // Extent along x.  May be negative, which means empty.
    w: Int
    // Extent along y.  May be negative, which means empty.
    h: Int

