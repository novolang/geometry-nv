// embedded_probe.nv — `geompoint`, `geomrect` and `geomxform` on a
// microcontroller, as firmware that builds for a Cortex-M, boots there
// and checks its answers.
//
// `scripts/shard_audit.sh`'s `core-embedded` row copies this file and
// the modules it reaches through `use`, transitively, into a package of
// its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a Cortex-M4 ELF or fails.  The same ELF boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and writes `PASS: geometry-embedded` when every answer is right.
// `--target=nrf52-qemu` holds every function it compiles to the
// embedded surface, so the build also checks that the three modules
// allocate nothing and call nothing from the C maths library.
//
// `geompoly`, `geompack`, `geomtrig` and `geomtext` are not here.  The
// first two hold lists, the third calls the C maths library and the
// fourth builds text, and one host-only function anywhere in a
// compilation unit is an undefined symbol at link time whether or not
// the firmware calls it.
//
// The expected answers are exact.  Every number involved is a small
// whole number or a half, so no rounding enters.

use geompoint
use geomrect
use geomxform

// The transform chain a display driver runs: a viewport mapping, a
// point through it, and the answer read back out.  64.0 is the middle
// of a 128-pixel-wide screen.
@tier(embedded)
fn mapped_x() -> Float
    let src: GeomRectF = geomrect.of_xywh(0.0, 0.0, 1.0, 1.0)
    let dst: GeomRectF = geomrect.of_xywh(0.0, 0.0, 128.0, 64.0)
    let t: GeomXform = geomxform.mapping(src, dst)
    let p: GeomPointF = geomxform.apply_point(t, geompoint.ptf(0.5, 0.5))
    p.x

// The rectangle algebra a display driver clips with: a 64-pixel widget
// at x = 100 keeps 28 columns of a 128 by 64 screen.
@tier(embedded)
fn clipped_area() -> Float
    let screen: GeomRectF = geomrect.of_xywh(0.0, 0.0, 128.0, 64.0)
    let widget: GeomRectF = geomrect.of_xywh(100.0, 0.0, 64.0, 64.0)
    geomrect.area(geomrect.intersection(screen, widget))

// The vector arithmetic, with no square root.
@tier(embedded)
fn reach_sq() -> Float
    let v: GeomVecF = geompoint.between(geompoint.ptf(0.0, 0.0), geompoint.ptf(3.0, 4.0))
    geompoint.length_sq(v)

// A transform undone: scale by two about (1, 1), invert, and take the
// pixel the point (-0.5, 3.5) lands in after the round trip.
@tier(embedded)
fn round_trip_pixel() -> Int
    let t: GeomXform = geomxform.scaling_about(2.0, 2.0, geompoint.ptf(1.0, 1.0))
    let back: GeomXform = geomxform.invert(t)
    let p: GeomPointF = geomxform.apply_point(back, geomxform.apply_point(t, geompoint.ptf(0.0 - 0.5, 3.5)))
    let px: GeomPointI = geompoint.to_int_floor(p)
    px.x * 10 + px.y

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    let good = mapped_x() == 64.0 and clipped_area() == 1792.0 and reach_sq() == 25.0
    if good and round_trip_pixel() == 0 - 7
        hal.uart.write("PASS: geometry-embedded\n")
    else
        hal.uart.write("FAIL: geometry-embedded\n")
    loop
        core.rt.sleep_ms(1000)
